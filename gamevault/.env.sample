# ------------------------------------------------------------------
# GameVault environment configuration
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored so your key is never pushed to the repo.
# ------------------------------------------------------------------

# RAWG API key -- required for all game discovery / details requests.
# Get a free key at: https://rawg.io/apidocs
VITE_RAWG_API_KEY=your_rawg_api_key_here